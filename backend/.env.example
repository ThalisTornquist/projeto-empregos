# Somente desenvolvimento local. Em produção, use TRAMPOFACIL_AUTH_MODE=supabase.
TRAMPOFACIL_AUTH_MODE=local

# Deixe DATABASE_URL vazia para usar SQLite local.
# DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Necessários no modo Supabase (na hospedagem, cadastre como variáveis privadas).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# TRAMPOFACIL_CORS_ORIGINS=https://<usuario>.github.io
